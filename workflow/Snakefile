# Micro-C pipeline, based on https://micro-c.readthedocs.io/en/latest/index.html


# Import python libraries
import os
from os.path import join
import itertools
import yaml
import pandas as pd

# Set directories
WORKDIR = config["workdir"]
RESULTSDIR = join(WORKDIR,"results")
MICROCDIR = config["microcdir"]
SCRIPTSDIR = config["scriptsdir"]

# Get list of libraries/samples
manifest = pd.read_table(config["manifest"])
LIBRARIES =  manifest['Library'].unique()
FASTQ_R1 = dict(zip(manifest['Library'], manifest['R1']))
FASTQ_R2 = dict(zip(manifest['Library'], manifest['R2']))
SAMPLES = manifest['Sample'].unique()
LIBRARY_TO_SAMPLE = dict(zip(manifest['Library'], manifest['Sample']))

# Define tools
with open(config["tools"]) as f:
    TOOLS = yaml.safe_load(f)

# Define resources per rule
with open(config["cluster"]) as f:
    CLUSTER = yaml.safe_load(f)

getthreads=lambda rname:int(CLUSTER[rname]["threads"]) if rname in CLUSTER and "threads" in CLUSTER[rname] else int(CLUSTER["__default__"]["threads"])
getmemg=lambda rname:CLUSTER[rname]["mem"] if rname in CLUSTER and "mem" in CLUSTER[rname] else CLUSTER["__default__"]["mem"]

# Define genomes
genome = config['genome']

# Helper to build the full input list for rule all
def get_all_inputs(wildcards=None):
    inputs = []

    # Stats file
    inputs += list(expand(join(RESULTSDIR, "bam", "{libraries}.dedup_stats.txt"), libraries=LIBRARIES))

    # Final bam and pairs files
    inputs += list(expand(join(RESULTSDIR, "bam", "{libraries}.pairs.gz"), libraries=LIBRARIES))
    inputs += list(expand(join(RESULTSDIR, "bam", "{libraries}.final.bam"), libraries=LIBRARIES))

    # QC summary
    inputs += list(expand(join(RESULTSDIR, "qc", "{libraries}.qc.txt"), libraries=LIBRARIES))
    inputs += [join(RESULTSDIR, "qc", "combined_qc.txt")]

    # Merged pairs file per sample
    inputs += list(expand(join(RESULTSDIR, "merged_pairs", "{sample}.pairs.gz"), sample=SAMPLES))

    # Contact map
    inputs += list(expand(join(RESULTSDIR, "hic", "{sample}.hic"), sample=SAMPLES))

    # Shallow-only:
    if config["depth"] == "shallow":
        # Preseq
        inputs += list(expand(join(RESULTSDIR, "qc", "{libraries}.preseq"), libraries=LIBRARIES))

        # MultiQC
        inputs += [join(RESULTSDIR, "qc", "multiqc_report.html")]

    # Deep only:
    if config["depth"] == "deep":
        # Convert hic to h5 at 10kb
        inputs += list(expand(join(RESULTSDIR, "h5", "{sample}.10kb.h5"), sample=SAMPLES))
        inputs += list(expand(join(RESULTSDIR, "h5", "{sample}.10kb.cool"), sample=SAMPLES))

        # AB compartments (FAN-C)
        inputs += list(expand(join(RESULTSDIR, "topology", "compartment", "{sample}_10kb.ab"), sample=SAMPLES))
        inputs += list(expand(join(RESULTSDIR, "topology", "compartment", "{sample}_10kb_eigen.bed"), sample=SAMPLES))
        inputs += list(expand(join(RESULTSDIR, "topology", "compartment", "{sample}_10kb_AB.bed"), sample=SAMPLES))
        inputs += list(expand(join(RESULTSDIR, "topology", "compartment", "{sample}_10kb_profile.png"), sample=SAMPLES))

        # TADs (Juicer Arrowhead)
        inputs += list(expand(join(RESULTSDIR, "topology", "tads", "{sample}.10kb_juicer_tads.txt"), sample=SAMPLES))
        inputs += list(expand(join(RESULTSDIR, "topology", "tads", "{sample}.5kb_juicer_tads.txt"), sample=SAMPLES))

        # TADs (HiCExplorer)
        inputs += list(expand(join(RESULTSDIR, "topology", "tads", "{sample}.10kb_tad_score.bm"), sample=SAMPLES))

        # Loops (Mustache)
        inputs += list(expand(join(RESULTSDIR, "topology", "loops", "{sample}_10kb_loops.tsv"), sample=SAMPLES))
        inputs += list(expand(join(RESULTSDIR, "topology", "loops", "{sample}_5kb_loops.tsv"), sample=SAMPLES))

        # Loops (HiCExplorer)
        inputs += list(expand(join(RESULTSDIR, "topology", "loops", "{sample}.10kb.bedpe"), sample=SAMPLES))

    return inputs

# Rules
include: "rules/topology.smk"

localrules: library_qc, library_complexity, combine_qc, multiqc

rule all:
    input: get_all_inputs

rule align:
    """Align reads to reference genome"""
    input:
        fastq_R1=lambda wildcards: f"{FASTQ_R1[wildcards.library]}",
        fastq_R2=lambda wildcards: f"{FASTQ_R2[wildcards.library]}"
    output:
        sam=temp(join(RESULTSDIR,"bam","{library}.sam"))
    params:
        bwa_ref = config[genome]['bwa_ref'],
        rg="{library}"
    threads:
        getthreads("align")
    envmodules:
        TOOLS["bwa"]
    shell:
        """
        bwa mem -5SP -T0 -t{threads} -R "@RG\\tID:{params.rg}\\tSM:{params.rg}\\tLB:{params.rg}\\tPL:ILLUMINA\\tPU:none" \
        -o {output.sam} \
        {params.bwa_ref} {input.fastq_R1} {input.fastq_R2}
        """

rule generate_pairs:
    """
    Generate pairs file
    Find ligation junctions from alignments with high mapping quality
    Records 5' outermost aligned base, read strands, pair type (flips so first read has lower coordinate)
    Sorts file
    Marks and removes PCR duplicates
    Splits into bam and pairs files, sort/index
    Final pairs file includes only UU, UR/RU pairs (unique-unique or unique-rescued)
    """
    input:
        sam=join(RESULTSDIR,"bam","{library}.sam")
    output:
        pairsam=temp(join(RESULTSDIR,"bam","{library}.parsed.pairsam")),
        sorted=temp(join(RESULTSDIR,"bam","{library}.sorted.pairsam")),
        dedup=temp(join(RESULTSDIR,"bam","{library}.dedup.pairsam")),
        stats=join(RESULTSDIR,"bam","{library}.dedup_stats.txt"),
        pairs=join(RESULTSDIR,"bam","{library}.pairs.gz"),
        unsorted=temp(join(RESULTSDIR,"bam","{library}.unsorted.bam")),
        bam=join(RESULTSDIR,"bam","{library}.final.bam")
    params:
        genome=config[genome]['chrom_sizes']
    threads:
        getthreads("generate_pairs")
    envmodules:
        TOOLS["pairtools"],
        TOOLS["samtools"]
    shell:
        """
        pairtools parse --min-mapq 40 --walks-policy 5unique --max-inter-align-gap 30 \
        --nproc-in {threads} --nproc-out {threads} --chroms-path {params.genome} {input.sam} > {output.pairsam}

        pairtools sort --nproc {threads} --tmpdir=/lscratch/$SLURM_JOB_ID {output.pairsam} > {output.sorted}

        if [ -f {output.stats} ] ; then
            rm {output.stats}
        fi
        pairtools dedup --nproc-in {threads} --nproc-out {threads} --mark-dups --output-stats {output.stats} \
        --output {output.dedup} {output.sorted}

        pairtools split --nproc-in {threads} --nproc-out {threads} --output-pairs {output.pairs} \
        --output-sam {output.unsorted} {output.dedup}

        samtools sort -@{threads} -T /lscratch/$SLURM_JOB_ID/temp.bam -o {output.bam} {output.unsorted}
        samtools index {output.bam}
        """

rule library_qc:
    """Summarize library quality using stats file"""
    input:
        stats=join(RESULTSDIR,"bam","{library}.dedup_stats.txt")
    output:
        qc=join(RESULTSDIR,"qc","{library}.qc.txt")
    params:
        script=join(MICROCDIR,"get_qc.py")
    shell:
        """
        python3 {params.script} -p {input.stats} > {output.qc}
        """

rule combine_qc:
    """Combine QC metrics across libraries"""
    input:
        qc_files=expand(join(RESULTSDIR, "qc", "{library}.qc.txt"), library=LIBRARIES)
    output:
        combined=join(RESULTSDIR, "qc", "combined_qc.txt")
    params:
        script=join(SCRIPTSDIR, "combine_qc.sh")
    shell:
        """
        cd {RESULTSDIR}/qc && bash {params.script}
        """

rule library_complexity:
    """Calculate library complexity for shallow sequencing experiments"""
    input:
        bam=join(RESULTSDIR,"bam","{library}.final.bam")
    output:
        preseq=join(RESULTSDIR,"qc","{library}.preseq")
    envmodules:
        TOOLS["preseq"]
    shell:
        """
        preseq lc_extrap -bam -pe -extrap 2.1e9 -step 1e8 -seg_len 1000000000 -output {output.preseq} {input.bam}
        """

rule multiqc:
    """Aggregate Preseq QC metrics across libraries"""
    input:
        preseq=expand(join(RESULTSDIR, "qc", "{library}.preseq"), library=LIBRARIES)
    output:
        report=join(RESULTSDIR, "qc", "multiqc_report.html")
    envmodules:
        TOOLS["multiqc"]
    shell:
        """
        cd {RESULTSDIR}/qc && multiqc .
        """

rule merge_pairs:
    """Combine pairs files from multiple libraries per sample"""
    input:
        pairs=lambda wildcards: [join(RESULTSDIR, "bam", f"{library}.pairs.gz") for library in LIBRARIES if LIBRARY_TO_SAMPLE[library] == wildcards.sample]
    output:
        merged_pairs=join(RESULTSDIR,"merged_pairs","{sample}.pairs.gz")
    threads:
        getthreads("merge_pairs")
    resources:
        mem = getmemg("merge_pairs")
    envmodules:
        TOOLS["pairtools"]
    shell:
        """
        pairtools merge -o {output.merged_pairs} \
            --tmpdir /lscratch/$SLURM_JOB_ID --memory {resources.mem} --nproc {threads} --nproc-in {threads} --nproc-out {threads} \
                {input.pairs} 
        """

rule contact_matrix_hic:
    """Generate .hic contact map from pairs file (resolutions 2.5M, 1M, 500K, 250K, 100K, 50K, 25K, 10K, and 5K)"""
    input:
        pairs=join(RESULTSDIR,"merged_pairs","{sample}.pairs.gz")
    output:
        map=join(RESULTSDIR,"hic","{sample}.hic")
    params:
        genome=config[genome]['chrom_sizes']
    threads:
        getthreads("contact_matrix_hic")
    envmodules:
        TOOLS["juicer"]
    shell:
        """
        juicer_tools -Xmx96g pre --threads {threads} {input.pairs} {output.map} {params.genome}
        """
