#!/usr/bin/env bash
# Launcher for the MicroC pipeline; shared logic is in bin/launcher.sh (copied from biowulf-snakemake-launcher).
# shellcheck disable=SC2034  # variables below are read by launcher.sh

PIPELINE_NAME="MicroC"
PIPELINE_DESCRIPTION="run the MicroC pipeline"
PIPELINE_USAGE_EXTRA="  -d/--depth=<DEPTH>       Sequencing depth: 'shallow' (default) or 'deep'; sets depth in
config.yaml and selects the matching cluster config (init only)"

DEPTH="shallow"

pipeline_parse_arg() {
  case "$1" in
    -d=*|--depth=*)
      DEPTH="${1#*=}"
      if [[ "$DEPTH" != "shallow" && "$DEPTH" != "deep" ]]; then
        err "DEPTH must be 'shallow' or 'deep' (got '$DEPTH')"
      fi
      return 0
      ;;
  esac
  return 1
}

pipeline_init_hook() {
  if [[ "$DEPTH" == "shallow" ]]; then
    cp "${PIPELINE_HOME}/resources/cluster_shallow.yaml" "${WORKDIR}/config/cluster.yaml"
  fi
  sed -i "s/^depth:.*/depth: ${DEPTH}/" "${WORKDIR}/config/config.yaml"
  echo "Depth: ${DEPTH}"
}

PIPELINE_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [[ ! -f "${PIPELINE_HOME}/bin/launcher.sh" ]]; then
  echo "ERROR: ${PIPELINE_HOME}/bin/launcher.sh not found." >&2
  exit 1
fi
# shellcheck source=/dev/null
source "${PIPELINE_HOME}/bin/launcher.sh"
main "$@"
